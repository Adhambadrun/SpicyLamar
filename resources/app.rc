#include <windows.h>

// Icon
1 ICON "icon.ico"

// Manifest
1 RT_MANIFEST "app.manifest"

// Version Info
1 VERSIONINFO
FILEVERSION     4,0,0,0
PRODUCTVERSION  4,0,0,0
FILEFLAGSMASK   0x3FL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SpicyLamar"
            VALUE "FileDescription",  "Spicy Lamar RingCentral Auto-Answer"
            VALUE "FileVersion",      "4.0.0.0"
            VALUE "InternalName",     "SpicyLamarAutoAnswer"
            VALUE "LegalCopyright",   "\xA9 SpicyLamar"
            VALUE "OriginalFilename", "SpicyLamar RingCentral Auto-Answer.exe"
            VALUE "ProductName",      "Spicy Lamar Auto-Answer"
            VALUE "ProductVersion",   "4.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
